{
  "name": "jarvis-desktop",
  "version": "0.3.0",
  "description": "J.A.R.V.I.S: a personal desktop AI that reads the screen, drives the desktop, and answers to sir.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "tour": "electron . --tour",
    "test:db": "node --test src/db.test.js",
    "dist": "node scripts/make-voice-lines.js && electron-builder --win --config electron-builder.config.js",
    "dist:mac": "electron-builder --mac --config electron-builder.config.js",
    "test": "node --test src/*.test.js companion/test/*.test.js",
    "dist:check": "node scripts/package-security-check.js",
    "setup:voice": "node scripts/setup-voice.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Om Senjalia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omsenjalia/nus-desktop.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "@supabase/supabase-js": "^2.112.3",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.1",
    "openai": "^7.5.0",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
